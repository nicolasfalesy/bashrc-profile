# ~/.blerc — ble.sh settings (linked from the bashrc-profile repo).
# Docs: https://github.com/akinomyoga/ble.sh/blob/master/docs/ChangeLog.md
#       https://github.com/akinomyoga/ble.sh/wiki/Manual-%C2%A71-Introduction

# ── Syntax highlighting: commands green, unknown red, existing paths underlined
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1
# Every command that will really run is bold bright green (his pick, 2026-09-26).
# ble.sh's default gives each kind its own colour: functions purple (fg=99),
# aliases teal, builtins red, programs green. Most of what he types here is
# a function or an alias (nas, t, vpn, z, ls, cd), so it read as "not a real
# command". fg=10 is the terminal's bright green, so it follows the theme.
ble-face command_file='fg=10,bold' command_function='fg=10,bold' \
         command_alias='fg=10,bold' command_builtin='fg=10,bold' \
         command_builtin_dot='fg=10,bold' command_jobs='fg=10,bold'
# Keywords (if, then, for, while) in the theme's accent. fg=17 is palette slot
# 17, which kitty-accent.conf sets to the accent on every theme switch, so it
# follows the theme like the Claude status line does (his pick, 2026-09-26).
ble-face command_keyword='fg=17'
# ...but some themes (Kanagawa) set the accent to the text colour, and then
# keywords look like plain text. There, use the terminal's bright blue instead
# (his pick, 2026-09-26). Checked once per new shell from the theme's
# colors.toml, with read (no fork), so a theme switch reaches new terminals only.
_blerc_accent= _blerc_fg=
if [[ -r ${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml ]]; then
    while IFS= read -r _blerc_line; do
        [[ $_blerc_line =~ ^[[:space:]]*(accent|foreground)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]] || continue
        [[ ${BASH_REMATCH[1]} == accent ]] && _blerc_accent=${BASH_REMATCH[2],,} || _blerc_fg=${BASH_REMATCH[2],,}
    done < "${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme/colors.toml"
    [[ $_blerc_accent && $_blerc_accent == "$_blerc_fg" ]] && ble-face command_keyword='fg=12'
fi
unset -v _blerc_accent _blerc_fg _blerc_line
# Typos (and real syntax errors) in red text, not the white-on-red block.
ble-face syntax_error='fg=9'

# ── Autosuggestions (fish-style grey text from history / completion)
#   accept whole suggestion: →  or End  or Ctrl-F
#   accept one word:         Alt-F
#   ignore it:               just keep typing
bleopt complete_auto_complete=1
bleopt complete_auto_history=1
# ms to wait after a keystroke before suggesting. 100 again since 2026-09-26:
# he wants the grey text sooner. It was 300 from 2026-09-23 because at 100
# ble.sh works out a suggestion for nearly every key and throws it away
# ("git status -s" at 150 ms a key: 72 ms of CPU per key at 100, 47 at 300).
bleopt complete_auto_delay=100
# ...and wake every 10 ms, not 20, while a suggestion is pending. ble.sh waits
# for that timer in 20 ms naps and only notices a key between naps, so with a
# 300 ms wait a key typed 150-250 ms after the last one took ~29 ms to appear
# instead of ~15. At 10 ms it is ~18 ms, for ~2 ms more CPU per key; nothing
# wakes while no suggestion is pending (0 ms of CPU idle, measured). Measured in
# a pty stand-in for kitty, 2026-09-23: "git status -s" at 150/250 ms a key.
bleopt idle_interval=10
ble-face auto_complete='fg=242'       # grey

# ── Tab completion menu
#   Tab opens/cycles the menu, Shift-Tab goes back, arrows move, Enter picks, Esc closes
bleopt complete_menu_complete=1
bleopt complete_ambiguous=1           # match "abc" inside candidates, not only prefixes
bleopt complete_menu_style=align-nowrap
bleopt complete_menu_maxlines=12
bleopt complete_menu_filter=1         # keep typing to filter the open menu
# Softer menu colours (his pick, 2026-09-26: "more elegant"). The defaults are
# harsh: the picked item is flipped (reverse) and the text you filter with sits
# on a pale yellow block. Now the picked item is bold accent on the theme's grey
# (palette 8 = muted, 17 = accent via kitty-accent.conf, so both follow the
# theme), and the letters you typed are bold in each entry.
ble-face menu_complete_selected='fg=17,bg=8,bold' menu_complete_match='bold' \
         menu_filter_input='fg=17,bold' region_insert='fg=17,bg=8'
# region_insert is the menu pick previewed on the command line (default: blue
# on a white block, the harshest thing left in the 2026-09-26 screenshot).
# Show only the new part of each name in the menu ("systemd/", not
# ".local/share/systemd/" on every entry). Omarchy's inputrc turns
# menu-complete-display-prefix on, and ble.sh honours it by printing the whole
# path in each entry. Omarchy's rc loads its inputrc before this file runs.
builtin bind 'set menu-complete-display-prefix off'
# A Nerd Font icon before each file in the menu (his pick, 2026-09-26). ble.sh
# has no file icons, but every file entry goes through
# ble/complete/action:file/init-menu-item, which may set `prefix` (drawn before
# the name). The advice picks the icon from the type, then the extension: a
# bash `case`, no forks, so a 300-entry menu costs next to nothing. Written as
# \u escapes so no editor can strip the Private Use glyphs. Icons are nf-fa /
# nf-oct names from the Nerd Fonts cheat sheet; codepoints drift between font
# versions, so re-render them after a font update.
blehook/eval-after-load complete '
ble/function#advice after ble/complete/action:file/init-menu-item "
    local ret; ble/complete/action:file/.get-filename; local f=\$ret
    if [[ -h \$f ]]; then prefix=\$'\''\uf481 '\''          # nf-oct-file_symlink_file
    elif [[ -d \$f ]]; then prefix=\$'\''\uf114 '\''        # nf-fa-folder_o (outline, like the rest)
    else
        case \${f##*.} in
        png|jpg|jpeg|gif|webp|svg|bmp|ico|avif|heic) prefix=\$'\''\uf1c5 '\'' ;;  # nf-fa-file_image_o
        mp3|flac|ogg|opus|wav|m4a) prefix=\$'\''\uf1c7 '\'' ;;                  # nf-fa-file_audio_o
        mp4|mkv|webm|mov|avi) prefix=\$'\''\uf1c8 '\'' ;;                        # nf-fa-file_video_o
        zip|tar|gz|xz|zst|bz2|7z|rar|tgz) prefix=\$'\''\uf1c6 '\'' ;;            # nf-fa-file_archive_o
        pdf) prefix=\$'\''\uf1c1 '\'' ;;                                         # nf-fa-file_pdf_o
        md|txt|log|rst) prefix=\$'\''\uf0f6 '\'' ;;                              # nf-fa-file_text_o
        sh|bash|py|js|ts|rs|c|h|cpp|go|lua|qml|java|json|toml|yaml|yml|css|html|conf) prefix=\$'\''\uf1c9 '\'' ;;  # nf-fa-file_code_o
        *) [[ -x \$f ]] && prefix=\$'\''\uf489 '\'' || prefix=\$'\''\uf016 '\'' ;;  # nf-oct-terminal / nf-fa-file_o
        esac
    fi"
'

# ── Character widths: tell ble.sh what foot uses instead of letting it ask
#   WHY: the default (char_width_mode=auto) makes every new shell print test characters
#   and send foot 20 cursor-position queries, then redraw the whole prompt once the
#   answers come back. With the full-width fill line that redraw is expensive: in foot
#   on battery (power-saver) keys typed into a fresh terminal did not show until ~1.4 s
#   after it opened; with the answer given up front, ~1.0 s (measured 2026-09-23).
#   The values are what auto itself settles on in foot 1.28: `bleopt char_width_mode
#   char_width_version` printed west / 16.0 (emoji_version is already 16.0 by default).
#   kitty 0.48 auto-detects exactly the same (checked 2026-09-23, when it replaced foot
#   as the default terminal), so it gets the shortcut too.
#   Only when foot or kitty is the parent: tmux, ssh, other terminals and a nested `bash`
#   keep auto-detection. After a terminal upgrade, re-check from a nested `bash` with the
#   bleopt command above; `BASHRC_FOOT_WIDTHS=0 kitty` opens a terminal without this.
if [[ ${BASHRC_FOOT_WIDTHS-1} == 1 && -r /proc/$PPID/comm ]] && { read -r _blerc_parent < "/proc/$PPID/comm"; [[ $_blerc_parent == foot || $_blerc_parent == kitty ]]; }; then
    bleopt char_width_mode=west
    bleopt char_width_version=16.0
fi
unset -v _blerc_parent

# ── History
# history_share OFF since 2026-09-23. On, every Enter re-read
# $HISTFILE for other terminals' commands: 2 more sed and 1 more gawk per
# command, ~22 ms and ~33 ms of CPU each time. Off, each terminal still writes
# every command at once (lib/core.sh's `history -a`), and a new terminal starts
# with all of them; only terminals already open do not pick them up.
# NB ble.sh switches a boolean off with an EMPTY value: `history_share=0` would
# still be on. Turn it back on with history_share=1.
bleopt history_share=
bleopt history_lazyload=1

# history_share + HISTTIMEFORMAT: repair ble.sh's line bookkeeping (upstream bug, still in
# master as of 2026-09-20).
#   WHY: history_share tracks how far into $HISTFILE this shell has read ("rskip") in LINES,
#   but ble.sh counts ENTRIES in three places. lib/core.sh sets HISTTIMEFORMAT, so every
#   entry is TWO lines ("#<epoch>" + the command) and all three come up half short:
#     1. .initialize      clamps rskip to the entry count  -> a new shell re-imports the back
#                         half of the file ("loading history ..." on every command).
#     2. .add-rskip       advances by entries written      -> the shell re-reads its own line,
#                         so EVERY command landed in history twice (Up had to be pressed
#                         twice per command, and timestamps slid onto the wrong entry).
#     3. .load-recent-entries is told lines, not entries   -> imports twice as many entries
#                         from bash's list as really arrived.
#   Measured on an empty HISTFILE: `echo A; echo B; echo C` gave A A B B C C with
#   HISTTIMEFORMAT set and A B C without. Dropping the timestamps or history_share would
#   also "fix" it; this keeps both.
#   The guard matches the exact buggy call in .write, so once upstream changes that code
#   these advices switch themselves off instead of double-correcting. Undo = delete the block.
#   Read with ble.sh's own ble/function#getdef, which does not fork (it was a
#   $(declare -f ...), ~1.8 ms). The advices only matter while history_share is
#   on, and cost nothing otherwise, so they stay for when it is switched back.
_blerc_write_is_buggy() {
    local def
    ble/function#getdef ble/builtin/history/.write &&
        [[ $def == *'.add-rskip "$file" "$_ble_builtin_history_histapp_count"'* ]]
}
if _blerc_write_is_buggy; then
    # Line count of $HISTFILE as this shell starts, i.e. what bash itself is about to load.
    # .initialize runs lazily at the FIRST command, and counting then would skip whatever
    # another terminal wrote in between (measured: its first command never showed up here).
    # mapfile, not $(wc -l): no fork on the startup path.
    _bashrc_histfile_lines0=0
    if [[ -r ${HISTFILE-} ]]; then
        mapfile -t _bashrc_histfile_tmp < "$HISTFILE"
        _bashrc_histfile_lines0=${#_bashrc_histfile_tmp[@]}
        unset -v _bashrc_histfile_tmp
    fi
    ble/function#advice around ble/builtin/history/.initialize '
        local _bashrc_was=$_ble_builtin_history_initialized
        ble/function#advice/do
        if [[ ! $_bashrc_was && $_ble_builtin_history_initialized && -e ${HISTFILE-} ]] &&
            declare -p HISTTIMEFORMAT &>/dev/null; then
            ble/builtin/history/.set-rskip "$HISTFILE" "$_bashrc_histfile_lines0"
        fi'
    # flag_timestamp is .write's own local (1 when HISTTIMEFORMAT is declared), visible here
    # through bash's dynamic scoping; .write is the only caller of .add-rskip.
    ble/function#advice around ble/builtin/history/.add-rskip '
        ((flag_timestamp)) && ADVICE_WORDS[2]=$((ADVICE_WORDS[2]*2))
        ble/function#advice/do'
    # The true number of new entries is how far bash's own list grew since ble.sh last looked.
    ble/function#advice around ble/builtin/history/.load-recent-entries '
        local max; ble/builtin/history/.get-max
        ADVICE_WORDS[1]=$((max-_ble_builtin_history_prevmax))
        ble/function#advice/do'
fi
unset -f _blerc_write_is_buggy

# ── Misc
bleopt edit_bell=abell                # flash instead of beep
# No "[exit N]" line after a failed command (his pick, 2026-09-26): the prompt's
# ❯ already turns red. Was $'\e[91m[exit %d]\e[m'.
bleopt exec_errexit_mark=
bleopt prompt_eol_mark=$'\e[94m⏎\e[m'  # marks output that lacked a final newline
