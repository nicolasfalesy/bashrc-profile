# ~/.blerc — ble.sh tuning (linked from the bashrc-profile repo).
# Goal on a Pi: keep syntax highlighting (commands green, errors red, paths
# underlined), drop the per-keystroke work that burns CPU over ssh.

# Syntax highlighting: ON (this is the "green when the command exists" feature)
bleopt highlight_syntax=1
bleopt highlight_filename=1
bleopt highlight_variable=1

# Auto-suggestions from history on every keystroke: OFF (CPU hog on a Pi).
# Set to 1 on a desktop if you like fish-style grey suggestions.
bleopt complete_auto_complete=
bleopt complete_auto_history=

# Don't pop the completion menu automatically
bleopt complete_menu_complete=
bleopt complete_ambiguous=

# Re-highlight less aggressively while typing
bleopt syntax_eval_polling_interval=50

# Keep: line editing, Ctrl-R history search (fzf), Tab completion
