#!/usr/bin/env bash
# bin/starship-omarchy-palette — make the starship prompt follow the Omarchy theme.
#
# Omarchy themes ship a colors.toml. This reads the one the current theme links,
# turns it into a starship [palettes.omarchy] table, appends that to the template
# (themes/omarchy-auto.toml, which references the colours by name and nothing
# else) and writes the result where STARSHIP_CONFIG points.
#
#   starship-omarchy-palette              regenerate if stale
#   starship-omarchy-palette --force      regenerate unconditionally
#   starship-omarchy-palette <slug>       ignored — the hook passes the new theme
#                                         name, but current/theme has already moved
#
# Wired up in two places:
#   • ~/.config/omarchy/hooks/theme-set.d/50-starship-palette  — every theme switch
#   • profiles/omarchy.sh — cold start, when the cache was cleared or the template
#     was edited more recently than the generated file
#
# Themes that omit a colour fall back to the terminal's own ANSI name (see
# `want` below), so this works against every theme, stock or custom.
set -uo pipefail

REPO=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
TEMPLATE=${BASHRC_STARSHIP_TEMPLATE:-$REPO/themes/omarchy-auto.toml}
# Deliberately NOT ${STARSHIP_CONFIG}: this runs from an interactive shell that
# already exports it, and an export left over from another theme would make the
# generator overwrite that theme instead of its own output.
OUT=${BASHRC_STARSHIP_OUT:-${XDG_CACHE_HOME:-$HOME/.cache}/bashrc-profile/starship-omarchy.toml}
THEME_DIR=${OMARCHY_THEME_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/current/theme}
COLORS=$THEME_DIR/colors.toml

force=0
[[ ${1-} == --force || ${1-} == -f ]] && force=1

[[ -r $TEMPLATE ]] || { echo "starship-omarchy-palette: no template at $TEMPLATE" >&2; exit 1; }
# The output is derived and rewritten without warning; never let it land on a
# hand-written theme in the repo.
[[ $OUT == "$REPO"/themes/* ]] && { echo "starship-omarchy-palette: refusing to write over a source theme ($OUT)" >&2; exit 1; }
[[ -r $COLORS   ]] || { echo "starship-omarchy-palette: no colors.toml at $COLORS" >&2; exit 1; }

# Nothing to do when the output is newer than both inputs. `-nt` resolves the
# current/theme symlink, so a theme switch (a different colors.toml, with its own
# older mtime) does NOT look stale here — that case is what the hook is for, and
# --force is the manual escape hatch.
if (( ! force )) && [[ -s $OUT && $OUT -nt $TEMPLATE && $OUT -nt $COLORS ]]; then
    exit 0
fi

# ── read colors.toml ─────────────────────────────────────────────────────────
# Values are quoted (`accent = "#7fbbb3"`), so a `#` only ever starts a comment
# outside the quotes — matching the quoted form is enough, no comment stripping.
declare -A c=()
line=''   # `set -u` + an empty colors.toml: read never assigns it
while IFS= read -r line || [[ -n $line ]]; do
    [[ $line =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*\"([^\"]*)\" ]] || continue
    c[${BASH_REMATCH[1]}]=${BASH_REMATCH[2]}
done < "$COLORS"

(( ${#c[@]} )) || { echo "starship-omarchy-palette: parsed no colours from $COLORS" >&2; exit 1; }

# want <palette-name> <candidate>...  — first candidate that is a key in
# colors.toml wins; a candidate that is not a key is used as a literal, which is
# how the ANSI fallbacks at the end of each chain work.
want() {
    local name=$1 k last=
    shift
    for k; do
        last=$k
        if [[ -n ${c[$k]-} ]]; then printf '%s = "%s"\n' "$name" "${c[$k]}"; return; fi
    done
    # No candidate was a key, so fall back to the LAST one — the literal each
    # chain ends in, which is a colour name starship knows. Using $1 here would
    # emit the first candidate instead, i.e. the name of a key that is missing
    # ("magenta", "accent"), which starship does not accept as a colour.
    printf '%s = "%s"\n' "$name" "$last"
}

# tones <bg-hex> <fg-hex> — emit the two derived palette entries.
#
# The point is contrast that holds on every theme. Naming a theme colour for dim
# text is a gamble: `muted` and `selection` are background tones in most themes,
# so "subdued" reads as invisible on one theme and shouts on the next. Blending
# a fixed percentage along the theme's own background→foreground axis is no
# better — contrast is not linear in the blend, so 72% of the way lands at 10:1
# on vantablack and 3.5:1 on catppuccin-latte.
#
# So: walk the axis and stop at the FIRST blend that meets a contrast target.
# Every theme gets the same legibility, and the tone stays as quiet as it can
# while getting there. Light themes work unchanged — their foreground is simply
# the dark end of the same axis.
#
#   rule  2.5:1  the fill dots — present, never competing with the text
#   dim   4.5:1  WCAG AA for body text: the clock, untracked count, path prefix
#
# awk because this needs sRGB gamma, and it runs once per theme switch, never
# per prompt. No gawk extensions (no strtonum), so it works with mawk too.
tones() {
    awk -v bghex="${1#\#}" -v fghex="${2#\#}" '
    function hex2(s,   i, c, d, n) {
        n = 0
        for (i = 1; i <= 2; i++) {
            c = tolower(substr(s, i, 1))
            d = index("0123456789abcdef", c) - 1
            if (d < 0) exit 1
            n = n * 16 + d
        }
        return n
    }
    function chan(v,   x) { x = v / 255; return x <= 0.04045 ? x / 12.92 : ((x + 0.055) / 1.055) ^ 2.4 }
    function lum(r, g, b) { return 0.2126 * chan(r) + 0.7152 * chan(g) + 0.0722 * chan(b) }
    function ratio(a, b,   hi, lo) { hi = a > b ? a : b; lo = a > b ? b : a; return (hi + 0.05) / (lo + 0.05) }
    # Test the ROUNDED colour, not the float blend: rounding each channel to an
    # integer moves the ratio a little, and testing before rounding let a tone
    # ship a hair under target (ethereal landed at 4.49 against a 4.5 target).
    function pick(target,   p, r, g, b) {
        for (p = 0; p <= 100; p++) {
            r = int(BR + (FR - BR) * p / 100 + 0.5)
            g = int(BG + (FG - BG) * p / 100 + 0.5)
            b = int(BB + (FB - BB) * p / 100 + 0.5)
            if (ratio(lum(r, g, b), LB) >= target)
                return sprintf("#%02x%02x%02x", r, g, b)
        }
        # The foreground itself cannot reach the target on this theme; it is the
        # most readable colour available, so use it rather than something worse.
        return sprintf("#%02x%02x%02x", FR, FG, FB)
    }
    BEGIN {
        if (length(bghex) != 6 || length(fghex) != 6) exit 1
        BR = hex2(substr(bghex, 1, 2)); BG = hex2(substr(bghex, 3, 2)); BB = hex2(substr(bghex, 5, 2))
        FR = hex2(substr(fghex, 1, 2)); FG = hex2(substr(fghex, 3, 2)); FB = hex2(substr(fghex, 5, 2))
        LB = lum(BR, BG, BB)
        printf "rule = \"%s\"\n", pick(2.5)
        printf "dim = \"%s\"\n",  pick(4.5)
    }'
}

palette() {
    printf '\n# ── generated from %s ─────────────────\n' "${COLORS/#"$HOME"/\~}"
    printf '[palettes.omarchy]\n'
    want background       background "black"
    want foreground       foreground "white"
    want accent           accent blue "blue"
    want muted            muted dark_foreground "bright-black"
    want selection        selection muted "bright-black"
    want light_foreground light_foreground foreground "white"
    want dark_foreground  dark_foreground muted "bright-black"
    want red              red "red"
    want green            green "green"
    want yellow           yellow "yellow"
    want orange           orange yellow "yellow"
    want blue             blue "blue"
    want cyan             cyan "cyan"
    want magenta          magenta "purple"
    # Derived from this theme's own contrast, not named: see tones() above.
    if ! tones "${c[background]-}" "${c[foreground]-}" 2>/dev/null; then
        printf 'rule = "bright-black"\ndim = "white"\n'   # no usable pair; let the terminal decide
    fi
}

# <HOME> in the template becomes this machine's home folder. Starship does not
# expand ~ or $HOME in a custom module's `shell` list, and the template is in a
# public repo, so it cannot hold the real path. The replacement is quoted, so
# an & in $HOME stays an & (patsub_replacement).
tpl=$(<"$TEMPLATE") || exit 1

tmp=$OUT.$$
mkdir -p -- "${OUT%/*}" || exit 1
{
    printf '# GENERATED by bin/starship-omarchy-palette — do not edit, every theme\n'
    printf '# switch overwrites it. Edit the template instead:  bt theme\n'
    printf '%s\n' "${tpl//<HOME>/"$HOME"}"
    palette
} > "$tmp" || { rm -f -- "$tmp"; exit 1; }
mv -f -- "$tmp" "$OUT" || { rm -f -- "$tmp"; exit 1; }
